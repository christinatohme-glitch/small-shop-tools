{
  "name": "northstar-shop-tools",
  "version": "1.0.0",
  "description": "Offline inventory, sales, expenses and profit dashboard for small shops.",
  "main": "main.js",
  "author": "Northstar Shop Tools",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist-win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.northstarshoptools.desktop",
    "productName": "Northstar Shop Tools",
    "directories": { "output": "dist" },
    "files": ["main.js", "index.html", "package.json"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "Northstar-Shop-Tools-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Northstar Shop Tools"
    }
  }
}
